# printpapi server configuration. Copy to `.env` (git-ignored) and edit:
#   cp .env.example .env
# `python -m app.server` reads ./.env on start. `docker compose` uses it to fill in
# PRINTAPI_TOKEN only (the container's PRINT_DB is fixed in docker-compose.yml).
# A variable already set in the real environment wins over this file.
# Full reference: docs/server.md#configuration

# Bootstrap/admin token — treat like a password. Generate one: openssl rand -hex 32
PRINTAPI_TOKEN=change-me

# SQLite database path and listen port
PRINT_DB=printpapi.db
PRINT_PORT=3460

# Log every HTTP request (any non-empty value)
# LOG_REQUESTS=1

# `open` lets anyone create an org via POST /signup — for a hosted deployment, not a private box
# PRINTAPI_SIGNUP=closed

# This server's own address; password-reset mails carry a link only when it is set
# PUBLIC_URL=https://print.example.com

# Mail for password resets. Without SMTP_HOST the reset token is printed to stderr instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=printpapi@example.com
# SMTP_SSL=0
# SMTP_STARTTLS=1

# Billing (see docs/billing.md): a JSON array of plans or a path to a file holding one,
# and the shared secret for the POST /billing/webhook signature. Unset => billing off.
# PRINTAPI_PLANS=plans.json
# PRINTAPI_BILLING_SECRET=
